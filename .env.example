# Copy this file to .env and fill in the values. .env is git-ignored.

# Your Anthropic API key (create it in the Anthropic console; set a spend limit there).
ANTHROPIC_API_KEY=

# Model the agent reasons with. Kept as a setting so it can be swapped without code changes.
LLM_MODEL=claude-haiku-5-5

# Stronger model used only by the evaluation judge.
JUDGE_MODEL=claude-sonnet-5-5

# Where the agent finds its MCP servers. Leave blank to use the ones
# running inside this same service. Set these to split them into separate services.
MCP_POLICY_URL=
MCP_HR_URL=

# Shared secret between the agent and the HR server. Leave blank when the servers
# run inside this service (a random one is made at each start). Set the same value
# on both sides only if you split the HR server into its own service.
MCP_INTERNAL_TOKEN=

# Safety limit: the most tool-calling rounds the agent may take per request.
AGENT_MAX_STEPS=8

# The most chat requests the service answers per day. The deployed demo is public,
# so this caps what a stranger could spend on your API key.
DAILY_CHAT_LIMIT=300

# How many policy chunks retrieval returns.
RETRIEVAL_TOP_K=5

# Retrieval: "hybrid" (keyword + vector), "vector" or "keyword".
RETRIEVAL_MODE=hybrid

# Evaluation experiments only. Tool names, separated by commas, to hide from the model.
# Leave blank in normal use.
DISABLED_TOOLS=
